{
  "name": "plsremind",
  "version": "0.0.0",
  "private": true,
  "description": "Client for the plsremind hub: gateway, cache and REST",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./optimistic": {
      "types": "./dist/optimistic/index.d.ts",
      "default": "./dist/optimistic/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:hub": "vitest run --project hub"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
