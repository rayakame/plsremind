# Copy to .env and fill in. docker compose reads .env from this folder; updates never touch it.

# Required: 32 random bytes, base64 encoded, for example from "openssl rand -base64 32". Keep it
# with your backups: the sign-in providers' secrets and the linked accounts' tokens are encrypted with it.
PLSREMIND_SECRET_KEY=

# The address people open in their browser; left empty, http://localhost and PLSREMIND_PORT.
PLSREMIND_PUBLIC_URL=
# The port the hub listens on, on this machine.
PLSREMIND_PORT=8080
# The password of the bundled PostgreSQL.
POSTGRES_PASSWORD=plsremind
# Behind a reverse proxy: the header that carries the client's address, such as X-Forwarded-For.
PLSREMIND_PROXY_HEADER=

# The Discord bot, with "docker compose --profile discord up -d".
DISCORD_TOKEN=
PLSREMIND_DISCORD_TOKEN=

# Monitoring, with "docker compose --profile monitoring up -d".
PLSREMIND_GRAFANA_PASSWORD=
PLSREMIND_GRAFANA_PORT=3000
PLSREMIND_ALERTMANAGER_URL=
