{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "always-update": true,
  "pull-request-header": "Merging this pull request releases the version below.",
  "pull-request-footer": "Written from the commit titles since the last release.",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "plsremind",
      "include-component-in-tag": false,
      "exclude-paths": ["sdk/python", "sdk/ts"],
      "extra-files": [
        {
          "type": "generic",
          "path": "connections/discord/plsremind_discord/about.py"
        },
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages.web.version"
        }
      ],
      "initial-version": "0.1.0"
    },
    "sdk/python": {
      "release-type": "simple",
      "component": "sdk-python",
      "extra-files": [
        {
          "type": "generic",
          "path": "plsremind/internal/about.py"
        }
      ],
      "initial-version": "0.1.0"
    },
    "sdk/ts": {
      "release-type": "node",
      "component": "sdk-ts",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['sdk/ts'].version"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
